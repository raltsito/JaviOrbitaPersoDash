# Copia este archivo a backend/.env y ajusta los valores.

# Clave secreta de Django — genera una propia para producción
SECRET_KEY=cambia-esta-clave

# True en desarrollo, False en producción
DEBUG=True

# Hosts permitidos, separados por coma
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — local en dev, la URL del plugin de Railway en producción
DATABASE_URL=postgresql://postgres:password@localhost:5432/orbita_javier

# Orígenes del frontend en desarrollo (Vite)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Dominio público en producción (para CSRF), separado por coma
CSRF_TRUSTED_ORIGINS=

# Zona horaria del usuario
TIME_ZONE=America/Mexico_City
